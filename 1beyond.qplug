  -- this portion is for the PTZ of the camera
  CameraPTZUp.EventHandler = function()
     if CameraMoving == false then
      CameraMoving = true
      HttpClient.Post{
        Url = "http://"..ServerURL.String..":3579/api/StartPT",
        Headers = {
          ["Content-Type"] = "application/json",
          Authorization = token
        },
        Timout = 5,
        Data = "{\"cam\":\""..CameraSelect.String.."\", \"ptDir\":\"0\"}",
        EventHandler = function(table, code, data, err, headers)
          if DebugInfo then print("Code: "..code) end 
          if DebugInfo then print("data: "..data) end
          parseResponse(data)
          if err ~= nil and DebugInfo then print("Error: "..err) end
        end
      }
    else
      CameraMoving = false
      HttpClient.Post{
        Url = "http://"..ServerURL.String..":3579/api/StopPT",
        Headers = {
          ["Content-Type"] = "application/json",
          Authorization = token
        },
        Timout = 5,
        Data = "{\"cam\":\""..CameraSelect.String.."\"}",
        EventHandler = function(table, code, data, err, headers)
