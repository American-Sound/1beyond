--Start event based logic
if Controls then

  json = require("rapidjson")
  
  -- Control aliases
  Status                = Controls.Status
  AutoSwitchStatus      = Controls.AutoSwitchStatus
  Username              = Controls.Username
  Password              = Controls.Password
  ServerURL             = Controls.ServerURL
  AutoSwitchEnable      = Controls.AutoSwitchEnable
  LayoutSelect          = Controls.LayoutSelect
  SceneSelect           = Controls.SceneSelect
  CameraSelect          = Controls.CameraSelect
  CameraPTZUp           = Controls.CameraPTZUp
  CameraPTZDown         = Controls.CameraPTZDown
  CameraPTZLeft         = Controls.CameraPTZLeft
  CameraPTZRight        = Controls.CameraPTZRight
  CameraPTZZoomIn       = Controls.CameraPTZZoomIn
  CameraPTZZoomOut      = Controls.CameraPTZZoomOut
  CameraTrackOn         = Controls.CameraTrackOn
  CameraTrackOff        = Controls.CameraTrackOff
  CameraPresetNumber    = Controls.CameraPresetNumber
  CameraPresetRecall    = Controls.CameraPresetRecall
  CameraPresetSave      = Controls.CameraPresetSave
  RestartVX             = Controls.RestartVX
  Reconnect             = Controls.Reconnect
  
  -- Variables and flags
  DebugInfo     = false
  DebugFunction = false
  DebugPrint    = Properties["Debug Print"].Value

  loggedIn = false
  encoded = ""
  token = ""
  arLayouts = {}
  arScenes = {}
  CameraMoving = false
  
  -- Sockets and services
  
  -- Timers, tables, and constants
  StatusState    = { 
    OK           = 0, 
    COMPROMISED  = 1, 
    FAULT        = 2, 
    NOTPRESENT   = 3, 
    MISSING      = 4, 
    INITIALIZING = 5
  }

  pollStatus = Timer.New()

  Status.Value = 5 --Initializing

   -- A function to determine common print statement scenarios for troubleshooting
    function SetupDebugPrint()
      if DebugPrint == "Function Calls" then
        DebugFunction = true
      elseif DebugPrint == "Notification" then
        DebugInfo = true
      elseif DebugPrint == "All" then
        DebugInfo,DebugFunction = true,true
      end
    end

  -- this function converts a string to base64
  function to_base64(data)
    if DebugFunction then print("to_base64() Called") end
    local b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
    return ((data:gsub('.', function(x) 
      local r,b='',x:byte()
      for i=8,1,-1 do r=r..(b%2^i-b%2^(i-1)>0 and '1' or '0') end
      return r;
    end)..'0000'):gsub('%d%d%d?%d?%d?%d?', function(x)
      if (#x < 6) then return '' end
        local c=0
        for i=1,6 do c=c+(x:sub(i,i)=='1' and 2^(6-i) or 0) end
        return b:sub(c+1,c+1)
      end)..({ '', '==', '=' })[#data%3+1])
  end

  -- Update Authorization when username or password changes. 
  Username.EventHandler = function()
    if string.len(Username.String) > 0 and string.len(Password.String) > 0  then
      local data = Username.String .. ":" .. Password.String
      encoded = to_base64(data)
      if DebugInfo then print(encoded) end
      if string.len(ServerURL.String) > 0 then logIn() end
    end
  end

  Password.EventHandler = function()
    if string.len(Username.String) > 0 and string.len(Password.String) > 0 then
      local data = Username.String .. ":" .. Password.String
      encoded = to_base64(data)
      if DebugInfo then print(encoded) end
      if string.len(ServerURL.String) > 0 then logIn() end
    end
  end
  
  --If URL is updated after usename and passward, login. 
  ServerURL.EventHandler = function()
    if string.len(ServerURL.String) > 0 and string.len(encoded) > 0 then
      logIn()
    end    
  end

  --This generates the token for future commands. 
  function logIn()
    if DebugFunction then print("logIn() Called") end
    HttpClient.Post{
      Url = "http://"..ServerURL.String..":3579/get-token",
      Headers = {
        ["Content-Type"] = "application/json",
        Authorization = encoded
      },
      Timout = 5,
      Data = "",
      EventHandler = function(table, code, data, err, headers)
        if DebugInfo then print("Code: "..code) end
        if DebugInfo then print("data: "..data) end
        if string.find(data,"\"",21) ~= nil then 
          token = string.sub(data,string.find(data,"token\":\"")+8,string.find(data,"\"",string.find(data,"token\":\"")+8)-1) 
          if DebugInfo then print("Token is "..token) end
          loggedIn = true
          Status.Value = 0 --OK
          pollStatus:Start(2)
        else
          loggedIn = false
          Status.Value = 2 --FAULT
          Status.String = "Failed to log in to VX!"
          pollStatus:Stop()
        end
        if err ~= nil and DebugInfo then print("Error: "..err) end
      end
    } 
  end

  

  -- If URL, Username and password are all entered on startup, log in. 
  if string.len(ServerURL.String) > 0 and string.len(Username.String) > 0 and string.len(Password.String) > 0  then
    local data = Username.String .. ":" .. Password.String
    encoded = to_base64(data)
    if DebugInfo then print(encoded) end
    if string.len(ServerURL.String) > 0 then logIn() end
  end

  -- If Reconnect is triggered, log in. 
  Reconnect.EventHandler = function()
    if string.len(ServerURL.String) > 0 and string.len(Username.String) > 0 and string.len(Password.String) > 0  then
      local data = Username.String .. ":" .. Password.String
      encoded = to_base64(data)
      if DebugInfo then print(encoded) end
      if string.len(ServerURL.String) > 0 then logIn() end
    end
  end
  
  -- Get status every 2  seconds
  pollStatus.EventHandler = function()
    getStatus()
  end
  
  -- This functions gets all statuses from VX
  function getStatus()
    if DebugFunction then print("getStatus Called") end
    if loggedIn then
      HttpClient.Post{
	      Url = "http://"..ServerURL.String..":3579/api/GetAllStatus",
      	Headers = {
      		["Content-Type"] = "application/json",
      		Authorization = token
      	},
        Timout = 5,
        Data = "",
        EventHandler = function(table, code, data, err, headers)
          if DebugInfo then print("Code: "..code) end 
          if DebugInfo then print("data: "..data) end
          parseResponse(data)
          if err ~= nil and DebugInfo then print("Error: "..err) end
        end
      }
    end
  end

  -- This function parses any responses from the VX
  function parseResponse(Data)
    if DebugFunction then print("parseResponse() Called") end
    if Data ~= nil then
      
      --Find Auto Switch Status and update plugin
      start, stop = string.find(Data,"\"AutoSwitchStatus\",\"response_code\":")
      if start ~= nil then
        AutoStatCode = string.sub(Data,stop+1,stop+4)
        if DebugInfo then print("Auto Switch Response Code: "..AutoStatCode) end
        start, stop = string.find(Data,"\\\"results\\\":",stop)
        AutoSwitch = string.sub(Data,stop+1,stop+1)
        if DebugInfo then print("Auto Switch value "..AutoSwitch) end
        if AutoSwitch == "t" then
          AutoSwitchEnable.Boolean = true
          AutoSwitchStatus = true
          if DebugInfo then print("Auto Switch is Enabled") end
        elseif AutoSwitch == "f" then
          AutoSwitchEnable.Boolean = false
          AutoSwitchStatus = false
          if DebugInfo then print("Auto Switch is Disable") end
        else
          if DebugInfo then print("Auto Switch error") end
        end
      end
     
      --Find Camera Count and update plugin
      start = 0
      stop = 0
      emptyTable = {}
      start, stop = string.find(Data,"\"GetCameras\",\"response_code\":")
      if stop ~= nil then
        CamCode = string.sub(Data,stop+1,stop+4)
        if DebugInfo then print("Camera Response Code: "..CamCode) end
        camEnd = string.find(Data,"}]}",stop)
        getCam = string.sub(Data,stop,camEnd)
        if DebugInfo then print("Data received about cameras: "..getCam) end
        i = 0
        i2 = 0
        i3 = 0
        while true do
          i, i2 = string.find(getCam, "\\\"id\\\":", i+1)    -- find 'next' camera id
          if i == nil then break end
          i3 = string.find(getCam, ",\\\"model\\\":", i2)
          iCam = string.sub(getCam,i2+1,i3-1)
          if DebugInfo then print("Camera at pos "..i2.." is "..iCam) end
          table.insert(emptyTable, iCam)
          CameraSelect.Choices = emptyTable
        end
      end
     
      --Find Camera Status and update plugin
      start = 0
      stop = 0
      camStatEnd = 0
      start, stop = string.find(Data,"\"CameraStatus\",\"response_code\":")
      if stop ~= nil then 
        CamStatCode = string.sub(Data,stop+1,stop+4)
        if DebugInfo then print("Camera Status Response Code: "..CamStatCode) end
        start, stop = string.find(Data,"\\\"address\\\":\\\"",stop)
        camStatEnd = string.find(Data,"\\\",\\",stop)
        selectedCam = string.sub(Data,stop+1,camStatEnd-1)
        if DebugInfo then print("Selected Camera is "..selectedCam) end
        CameraSelect.String = selectedCam
      end
     
      --Find Layout Count and update plugin
      start = 0
      stop = 0
      start, stop = string.find(Data,"\"GetLayouts\",\"response_code\":")
      if stop ~= nil then
        LayoutStatCode = string.sub(Data,stop+1,stop+4)
        if DebugInfo then print("Layout Response Code: "..LayoutStatCode) end
        LayoutEnd = string.find(Data,"}]}",stop)
        getLayout = string.sub(Data,stop,LayoutEnd)
        if DebugInfo then print("Data received about layouts: "..getLayout) end
        i = 0
        i2 = 0
        i3 = 0
        arLayouts = {}
        while true do
          i, i2 = string.find(getLayout, "\\\"id\\\":\\\"", i+1)    -- find 'next' layout id
          if i == nil then break end
          i3 = string.find(getLayout, "\\\",\\\"name\\\":\\\"", i2)
          LayoutID = string.sub(getLayout,i2+1,i3-1)
          if DebugInfo then print("Layout ID at pos "..i2.." is "..LayoutID) end
          i, i2 = string.find(getLayout, ",\\\"name\\\":\\\"", i+1)    -- find 'next' layout name
          if i == nil then break end
          i3 = string.find(getLayout, "\\\"}", i2)
          LayoutName = string.sub(getLayout,i2+1,i3-1)
          if DebugInfo then print("Layout Name at pos "..i2.." is "..LayoutName) end
          table.insert(arLayouts, LayoutName)
          arLayouts[LayoutName] = LayoutID
          LayoutSelect.Choices = arLayouts
        end
      end
      
      --Find Layout Status and update plugin
      start = 0
      stop = 0
      layoutStatEnd = 0
      start, stop = string.find(Data,"\"LayoutStatus\",\"response_code\":")
      if stop ~= nil then
        layoutStatCode = string.sub(Data,stop+1,stop+4)
        if DebugInfo then print("Layout Status Response Code: "..layoutStatCode) end
        start, stop = string.find(Data,"\\\"name\\\":\\\"",stop)
        layoutStatEnd = string.find(Data,"\\\"}",stop)
        selectedLayout = string.sub(Data,stop+1,layoutStatEnd-1)
        if DebugInfo then print("Selected Layout is "..selectedLayout) end
        LayoutSelect.String = selectedLayout
      end

      --Find Scene Count and update plugin
      start = 0
      stop = 0
      start, stop = string.find(Data,"\"GetScenarios\",\"response_code\":")
      if stop ~= nil then
        SceneStatCode = string.sub(Data,stop+1,stop+4)
        if DebugInfo then print("Scene Response Code: "..SceneStatCode) end
        SceneEnd = string.find(Data,"}]}",stop)
        getScene = string.sub(Data,stop,SceneEnd)
        if DebugInfo then print("Data received about Scene: "..getScene) end
        i = 0
        i2 = 0
        i3 = 0
        arScenes = {}
        while true do
          i, i2 = string.find(getScene, "\\\"id\\\":", i+1)    -- find 'next' scene id
          if i == nil then break end
          i3 = string.find(getScene, ",\\\"name\\\":\\\"", i2)
          SceneID = string.sub(getScene,i2+1,i3-1)
          if DebugInfo then print("SceneID ID at pos "..i2.." is "..SceneID) end
          i, i2 = string.find(getScene, ",\\\"name\\\":\\\"", i+1)    -- find 'next' layout name
          if i == nil then break end
          i3 = string.find(getScene, "\\\"}", i2)
          SceneName = string.sub(getScene,i2+1,i3-1)
          if DebugInfo then print("Scene Name at pos "..i2.." is "..SceneName) end
          table.insert(arScenes, SceneName)
          arScenes[SceneName] = SceneID
          SceneSelect.Choices = arScenes
        end
      end
      
      --Find Scene Status and update plugin
      start = 0
      stop = 0
      sceneStatEnd = 0
      start, stop = string.find(Data,"\"ScenarioStatus\",\"response_code\":")
      if stop ~= nil then
        sceneStatCode = string.sub(Data,stop+1,stop+4)
        if DebugInfo then print("Scene Status Response Code: "..sceneStatCode) end
        start, stop = string.find(Data,"\\\"name\\\":\\\"",stop)
        sceneStatEnd = string.find(Data,"\\\"}",stop)
        selectedScene = string.sub(Data,stop+1,sceneStatEnd-1)
        if DebugInfo then print("Selected Layout is "..selectedScene) end
        SceneSelect.String = selectedScene
      end
    end
  end

  -- When Auto Switch is pressed toggle the Auto switch state
  AutoSwitchEnable.EventHandler = function()
    if AutoSwitchStatus then
      HttpClient.Post{
	      Url = "http://"..ServerURL.String..":3579/api/StopAutoSwitch",
      	Headers = {
      		["Content-Type"] = "application/json",
      		Authorization = token
      	},
        Timout = 5,
        Data = "",
        EventHandler = function(table, code, data, err, headers)
          if DebugInfo then print("Code: "..code) end 
          if DebugInfo then print("data: "..data) end
          parseResponse(data)
          if err ~= nil and DebugInfo then print("Error: "..err) end
        end
      }
    elseif AutoSwitchStatus == false then
      HttpClient.Post{
	      Url = "http://"..ServerURL.String..":3579/api/StartAutoSwitch",
      	Headers = {
      		["Content-Type"] = "application/json",
      		Authorization = token
      	},
        Timout = 5,
        Data = "",
        EventHandler = function(table, code, data, err, headers)
          if DebugInfo then print("Code: "..code) end 
          if DebugInfo then print("data: "..data) end
          parseResponse(data)
          if err ~= nil and DebugInfo then print("Error: "..err) end
        end
      }      
    end
    
  end

